# Prototype safety: leave false until the production content and policies are approved.
NEXT_PUBLIC_SITE_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep mock until the Shopify catalog is published and the storefront adapter is enabled.
COMMERCE_PROVIDER=mock
SHOPIFY_STORE_DOMAIN=
# Private token from Shopify's Headless channel. Server-side only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Optional launch integrations
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
