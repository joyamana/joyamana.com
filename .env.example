# Prototype safety: leave false until the production content and policies are approved.
NEXT_PUBLIC_SITE_INDEXABLE=false
# When indexing is enabled this must be the non-local HTTPS canonical origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bare myshopify.com store hostname used for Storefront API requests.
SHOPIFY_STORE_DOMAIN=
# Private token from Shopify's Headless channel. Server-side only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Checkout release gate. Enable only in an approved test or production environment.
SHOPIFY_CHECKOUT_ENABLED=false
# Optional branded Shopify-hosted checkout domain. Leave empty to use the myshopify.com host.
SHOPIFY_CHECKOUT_DOMAIN=

# Contact form delivery. Keep false until info@joyamana.com can receive mail,
# joyamana.com is verified in Resend, its privacy/data-processing use is approved,
# and production abuse controls are configured. RESEND_API_KEY is server-only.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=

# Reserved for a future approved GA4 integration; currently unused by runtime code.
NEXT_PUBLIC_GA4_ID=
# Optional Google site-verification metadata; account verification remains an external task.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
